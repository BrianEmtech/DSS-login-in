# Copy to .env at the repo root. One file serves both halves of the stack:
# Django loads it explicitly (config/settings.py), and Next.js picks up a root
# `.env` automatically — note Next does NOT look inside /src.
#
# Everything here is a placeholder. Never commit the filled-in .env.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Next.js reaches Django server-side, so this is an internal URL. It is not
# exposed to the browser.
DJANGO_INTERNAL_URL=http://localhost:8000

# --- Database -------------------------------------------------------------
POSTGRES_DB=dss
POSTGRES_USER=dss
POSTGRES_PASSWORD=dss
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Mail (Mailpit) -------------------------------------------------------
# OTPs and verification links land in the Mailpit UI at http://localhost:8025
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@dss.local

# --- Next.js --------------------------------------------------------------
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=dev-only-insecure-change-me

# Shared secret Next.js presents on every server-to-server auth call. Must be
# byte-identical on both sides. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=dev-only-insecure-change-me
